APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_HOSTS=["*"]

# Runtime database. Alembic reads this same variable.
DATABASE_URL=postgresql+asyncpg://vip:vip@localhost:5432/vip

# Database used by the integration/e2e test layers. Unset -> those layers skip.
# TEST_DATABASE_URL=postgresql+asyncpg://vip:vip@localhost:5433/vip_test
# Set to 1 in CI so a missing TEST_DATABASE_URL fails instead of skipping.
# TEST_REQUIRE_POSTGRES=1
